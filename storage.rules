rules_version = '2';

// Storage rules for node/group attachments.
// Path shape (see js/firebase-storage.js):
//   attachments/{userId}/{entityType}/{entityId}/{filename}
//
// Deploy with:
//   firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // 50 MB limit enforced server-side (client checks are advisory)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
