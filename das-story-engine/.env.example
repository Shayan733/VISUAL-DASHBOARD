# Bearer token every MCP call must carry (Authorization: Bearer <token>).
# Generate any long random string.
DSE_BEARER_TOKEN=change-me

# Port for the local server
PORT=8787

# Leave unset to use the local file-backed MemoryStore (default).
# Set BOTH to switch to the real Supabase store.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
